# Copy to backend/.env and fill in. Never commit backend/.env.
# On the Mac, DB_HOST=127.0.0.1 through the SSH tunnel; on the server, the MySQL private IP.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=loop
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=
GENAI_VISION_MODEL=cohere.command-a-vision
GENAI_TEXT_MODEL=cohere.command-a-03-2025
SCAN_TIMEOUT=
MEDIA_DIR=/home/opc/loop-media
PUBLIC_BASE_URL=
